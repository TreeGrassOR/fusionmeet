# =============================================================================
# FusionMeet: настройки развёртывания (deploy/compose.yaml)
#
# Не редактируйте этот файл. При первом запуске deploy/up.sh копирует его в
# deploy/.env, генерирует секреты, определяет LAN_IP и спрашивает email для
# Let's Encrypt. Повторные запуски up.sh сохраняют существующие значения в .env и
# только дописывают переменные, которых там ещё нет.
# deploy/.env содержит секреты: не публикуйте его (он в .gitignore) и храните
# резервную копию вместе с резервной копией данных.
# =============================================================================

# --- Адреса и сеть -----------------------------------------------------------

# Базовый домен. Из него строятся все адреса:
#   meet.<BASE_DOMAIN>    — интерфейс видеозвонков;
#   livekit.<BASE_DOMAIN> — сигнальный сервер LiveKit (WebSocket);
#   id.<BASE_DOMAIN>      — Keycloak (вход, учётные записи).
# sslip.io сам отвечает на DNS-запросы: имя 213-141-132-74.sslip.io указывает
# на 213.141.132.74, настраивать DNS не нужно.
BASE_DOMAIN=213-141-132-74.sslip.io

# Внешний (белый) IP сервера. LiveKit сообщает его участникам из интернета как
# адрес для аудио и видео (7881/tcp, 7882/udp должны быть проброшены на роутере).
PUBLIC_IP=213.141.132.74

# IP сервера в домашней сети (например 192.168.1.10). up.sh определяет его сам
# при первом запуске, если значение пустое. LiveKit сообщает этот адрес
# устройствам домашней сети и контейнерам, поэтому им не нужен NAT loopback
# на роутере для медиа. Закрепите адрес за сервером в DHCP роутера.
LAN_IP=

# Email для Let's Encrypt: туда приходят уведомления о сертификатах.
# up.sh спрашивает его при первом запуске (или берёт из переменной окружения
# ACME_EMAIL).
ACME_EMAIL=

# Адрес ACME-сервера Let's Encrypt. Для пробы без риска упереться в лимиты можно
# временно указать тестовый https://acme-staging-v02.api.letsencrypt.org/directory,
# но его сертификаты недоверенные: браузеры и сами сервисы (backend, агенты)
# не смогут работать, пока не вернёте рабочий адрес.
ACME_CA=https://acme-v02.api.letsencrypt.org/directory

# Порт Redis на 127.0.0.1 сервера. Он нужен LiveKit, который работает в сети
# хоста. Наружу порт не открывается. Измените, если он занят другим сервисом.
REDIS_HOST_PORT=16379

# Обратный прокси:
#   auto  — если порты 80/443 уже заняты nginx на сервере, FusionMeet встаёт за него:
#           up.sh добавляет в nginx файл fusionmeet.conf, который пересылает только
#           meet./id./livekit.<BASE_DOMAIN> в Caddy на 127.0.0.1 (остальные сайты
#           nginx не меняются). Иначе Caddy сам слушает 80/443.
#   caddy — всегда сам Caddy на 80/443;
#   nginx — всегда за nginx сервера.
# Сертификаты Let's Encrypt в обоих случаях получает и продлевает Caddy.
PROXY_MODE=auto
# Порты Caddy на 127.0.0.1 в режиме nginx (наружу не открываются).
CADDY_LOCAL_HTTP_PORT=18080
CADDY_LOCAL_HTTPS_PORT=18443

# Название сервиса: заголовок вкладки, страница входа, письма.
APP_TITLE=FusionMeet

# Часовой пояс времени в заголовке расшифровки (.md).
TRANSCRIPT_TIMEZONE=Europe/Moscow

# UID, от имени которого работают контейнеры backend, frontend и агентов
# (аргумент сборки образов, как в upstream). Обычно менять не нужно.
DOCKER_USER=1000

# --- Распознавание речи (сервис asr, GigaAM Multilingual) --------------------

# Сколько видеопамяти (ГБ) может занять asr. Сервис не возьмёт больше, даже если
# GPU свободна. install.sh сравнивает это значение со свободной видеопамятью.
ASR_MAX_VRAM_GB=4

# Модель на Hugging Face и её ревизия (коммит). Ревизия закреплена, чтобы
# обновление модели не меняло поведение без вашего ведома.
ASR_MODEL_ID=ai-sage/GigaAM-Multilingual
# Основной вариант: large_ctc (около 600 млн параметров).
ASR_MODEL_REVISION=3905cd51c3ed4e88c8edf33f3302969ba480a327
ASR_MODEL_VARIANT=large_ctc
# Сколько видеопамяти (ГБ) нужно основному варианту. Если в пределах
# ASR_MAX_VRAM_GB свободно меньше, загружается запасной вариант.
ASR_MODEL_VRAM_GB=3.0

# Запасной вариант: ctc (около 220 млн параметров), если на large_ctc не хватает
# видеопамяти. Если не хватает и на него, asr завершается с понятной ошибкой.
ASR_FALLBACK_REVISION=2f8a57144e6ec3adfd32fe0484d9ea9913305bc8
ASR_FALLBACK_VARIANT=ctc
ASR_FALLBACK_VRAM_GB=1.5

# Половинная точность (fp16) для энкодера: меньше памяти, быстрее.
ASR_FP16_ENCODER=true
# Пакетная обработка одновременных запросов: размер пакета, ожидание
# заполнения пакета (мс) и суммарная длительность аудио в пакете (с).
ASR_MAX_BATCH_SIZE=8
ASR_BATCH_WAIT_MS=20
ASR_MAX_BATCH_AUDIO_SECONDS=240
# Максимальная длина одного фрагмента речи (с).
ASR_MAX_AUDIO_SECONDS=30
# Сколько фрагментов может ждать в очереди; сверх этого asr отвечает 503.
ASR_MAX_QUEUE=64
# Подробность журнала asr: debug, info, warning, error.
ASR_LOG_LEVEL=info

# --- Почта (SMTP), необязательно ----------------------------------------------
# Без SMTP всё работает: записи и расшифровки доступны на странице
# «Мои записи и расшифровки», а письма только выводятся в журнал backend.
# Если указать SMTP_HOST, инициатор записи или расшифровки получит письмо
# со ссылкой.

# Адрес SMTP-сервера, например smtp.yandex.ru. Пусто — SMTP выключен.
SMTP_HOST=
# Порт: 587 (STARTTLS) или 465 (SSL).
SMTP_PORT=587
# Логин и пароль SMTP (для Яндекса и Mail.ru — пароль приложения).
# Если в значении есть $, # или пробел, заключите его в одинарные кавычки:
# SMTP_PASSWORD='пароль$с#символами'. Без кавычек docker compose подставит
# вместо $... пустую строку.
SMTP_USER=
SMTP_PASSWORD=
# STARTTLS (порт 587) или SSL (порт 465). Включайте только одно из двух.
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Адрес отправителя. Пусто — noreply@meet.<BASE_DOMAIN>.
SMTP_FROM=
# Адрес для вопросов, который указывается в письмах. Пусто — ACME_EMAIL.
SUPPORT_EMAIL=

# Служебная переменная, не меняйте: выбирает почтовый backend Django
# (smtp, если задан SMTP_HOST, иначе console). Должна идти после SMTP_HOST.
EMAIL_BACKEND_KIND=${SMTP_HOST:+smtp}

# --- Секреты -----------------------------------------------------------------
# Пустые значения up.sh заполняет случайными (openssl rand). Не меняйте их после
# первого запуска: они уже записаны в базы данных и хранилище.

# Секретный ключ Django.
DJANGO_SECRET_KEY=
# Пароль PostgreSQL для базы приложения (пользователь meet).
POSTGRES_PASSWORD=
# Пароль PostgreSQL для базы Keycloak (пользователь keycloak).
KEYCLOAK_DB_PASSWORD=
# Пароль администратора Keycloak (логин admin, https://id.<BASE_DOMAIN>/admin/).
KEYCLOAK_ADMIN_PASSWORD=
# Секрет OIDC-клиента meet в Keycloak (общий для Keycloak и backend).
OIDC_RP_CLIENT_SECRET=
# Пароль Redis.
REDIS_PASSWORD=
# Ключ и секрет API LiveKit (общие для LiveKit, backend, egress и агентов).
LIVEKIT_API_KEY=meet
LIVEKIT_API_SECRET=
# Секрет внутреннего RPC Garage (S3-хранилище).
GARAGE_RPC_SECRET=
# Ключ доступа к S3 (Garage): идентификатор GK… и секрет. Garage создаёт ключ
# при первом запуске и потом проверяет, что секрет не изменился.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Ключ доступа агента расшифровки к сервису asr.
ASR_API_KEY=
# Токен, с которым агент расшифровки сообщает backend о готовой расшифровке.
TRANSCRIPTION_AGENT_TOKEN=
